mesh "orbit" {
  canvas {
    width: 900
    height: 520
    background: #0A0C10
    font_family: "Open Sans"
    font_fallback: "Noto Sans"
  }

  linear_gradient "accent" {
    angle: 90
    stop(0.0, #65D9FF)
    stop(1.0, #A78BFA)
  }

  ring "orbit_track" {
    center: (220, 250)
    radius: 118
    inner_radius: 116
    fill: fade(#FFFFFF, 0.12)
  }

  circle "orbit_dot" {
    center: (220 + 118 * cos(t * 40), 250 + 118 * sin(t * 40))
    radius: 10
    fill: @accent
    glow(16, fade(#65D9FF, 0.45))
  }

  rect "meter_track" {
    x: 420
    y: 150
    width: 400
    height: 8
    radius: 4
    fill: #20242B
  }

  rect "meter" {
    x: 420
    y: 150
    width: oscillate(t, 0.18, 80, 400, 0)
    height: 8
    radius: 4
    fill: @accent
  }

  repeat "bars" {
    count: 12
    let h = oscillate(t, 0.22, 20, 92, i * 24)
    let x = 420 + i * 33
    rect {
      x: x
      y: 360 - h
      width: 18
      height: h
      radius: 9
      fill: mix(#65D9FF, #A78BFA, rep_t)
      opacity: 0.82
    }
  }

  line "scanline" {
    from: (420, 400)
    to: (820, 400)
    stroke: fade(#FFFFFF, 0.24)
    stroke_width: 1
    dash: [6, 8]
    dash_offset: -t * 40
  }

  text "label" {
    at: (420, 116)
    baseline: true
    content: "MOTION / DETERMINISTIC"
    size: 12
    weight: 700
    letter_spacing: 1.6
    fill: #7D8796
  }
}
