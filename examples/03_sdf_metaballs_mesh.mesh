// Example 3: SDF Smooth-Union Metaballs & 2D Tensor Mesh Gradient (.mesh v1.0.0)
// Demonstrates organic liquid boolean geometry (`smooth_union(k)`) and structured 2D mesh patches.

mesh "sdf_metaballs" {
  canvas {
    width: 640
    height: 420
    background: oklch(0.12, 0.02, 265)
    font_family: "Open Sans"
    font_fallback: "Noto Sans"
  }

  mesh_gradient "tensor_grid" {
    rows: 2
    cols: 2
    patch(0.0, 0.0, oklch(0.75, 0.23, 330))
    patch(1.0, 0.0, oklch(0.80, 0.18, 200))
    patch(0.0, 1.0, oklch(0.68, 0.22, 45))
    patch(1.0, 1.0, oklch(0.74, 0.20, 145))
  }

  boolean "liquid_metaball" {
    op: smooth_union(38)
    fill: @tensor_grid
    stroke: oklch(0.98, 0.01, 240, 0.70)
    stroke_width: 3
    stroke_align: inner
    shadow: (0, 16, 30, oklch(0.03, 0.01, 265, 0.80))

    circle "core_left" {
      center: (width * 0.36, height * 0.50)
      radius: 82
    }
    circle "core_right" {
      center: (width * 0.62, height * 0.48)
      radius: 74
    }
    circle "satellite_top" {
      center: (width * 0.50, height * 0.28)
      radius: 48
    }
  }

  text "caption" {
    at: (width * 0.5, height - 36)
    content: "SDF SMOOTH UNION + TENSOR MESH"
    size: 16
    align: center
    letter_spacing: 2
    fill: oklch(0.92, 0.03, 230)
  }
}
