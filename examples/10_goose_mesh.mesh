  }
  polygon {
    points: [
      (860 + oscillate(t, 0.06, -240, 380), 512),
      (1010 + oscillate(t, 0.06, -240, 380), 512),
      (900 + oscillate(t, 0.06, -240, 380), 788),
      (750 + oscillate(t, 0.06, -240, 380), 788)
