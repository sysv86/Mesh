  polygon { points: [(1284, 454), (1346, 454), (1284, 556), (1268, 556)]; fill: fade(#DFF7FF, 0.045); blend: screen }

  // ═══ GOOSE — BODY, TAIL, FOOT ═════════════════════════════════════════════
  // lamp warmth behind the goose
  ellipse { center: (430, 706); radii: (150, 210); fill: fade(#FFB45C, 0.10); blend: screen }

  // contact shadow on desk
  ellipse { center: (574, 840 + bob * 0.25); radii: (182, 28); fill: @shadow_soft }
  ellipse { center: (596, 860); radii: (92, 13); fill: fade(#000000, 0.32) }

  path "goose_body" {
    closed: true
    fill: @goose_body
