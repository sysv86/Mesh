  path { fill: none; stroke: fade(#D8C8B2, 0.55); stroke_width: 2; cap: round; center: (826, 350); rotate: tilt; translate: (0, bob); move(792, 306); cubic(800, 298, 808, 296, 816, 298) }
  path { fill: none; stroke: fade(#E7DAC7, 0.50); stroke_width: 1.8; cap: round; center: (826, 350); rotate: tilt; translate: (0, bob); move(786, 316); cubic(794, 308, 802, 306, 810, 308) }
  path { fill: none; stroke: fade(#CBB9A3, 0.42); stroke_width: 1.6; cap: round; center: (826, 350); rotate: tilt; translate: (0, bob); move(780, 328); cubic(788, 321, 796, 319, 804, 321) }

