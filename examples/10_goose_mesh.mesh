  path { fill: none; stroke: fade(#FFFDF7, 0.42); stroke_width: 1.4; cap: round; clip: @goose_body; translate: (0, bob * 0.35); move(470, 670); cubic(494, 680, 520, 680, 538, 672) }
  path { fill: none; stroke: fade(#FFFDF7, 0.34); stroke_width: 1.3; cap: round; clip: @goose_body; translate: (0, bob * 0.35); move(556, 630); cubic(580, 640, 608, 640, 628, 632) }

