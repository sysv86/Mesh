  path { fill: none; stroke: fade(#B39D84, 0.62); stroke_width: 1.5; cap: round; clip: @goose_body; translate: (0, bob * 0.35); move(492, 744); cubic(516, 756, 544, 758, 562, 750) }
  path { fill: none; stroke: fade(#AE967C, 0.58); stroke_width: 1.5; cap: round; clip: @goose_body; translate: (0, bob * 0.35); move(526, 788); cubic(552, 800, 584, 802, 604, 794) }
  path { fill: none; stroke: fade(#AE967C, 0.54); stroke_width: 1.5; cap: round; clip: @goose_body; translate: (0, bob * 0.35); move(574, 818); cubic(600, 828, 630, 826, 648, 816) }
  path { fill: none; stroke: fade(#B39D84, 0.50); stroke_width: 1.4; cap: round; clip: @goose_body; translate: (0, bob * 0.35); move(620, 782); cubic(640, 792, 662, 788, 674, 776) }
