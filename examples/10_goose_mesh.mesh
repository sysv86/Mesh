// ─────────────────────────────────────────────────────────────────────────────
// GOOSE / STUDIO 04 — Mesh format duel (Artist A)
// A late-night engineering studio: one handsome goose, five MacBooks, warm lamp,
// cold screens, rain-washed city window. 1600x1000. Animated, self-contained.
// ─────────────────────────────────────────────────────────────────────────────

mesh "goose_macbooks" {
  canvas {
    width: 1600
    height: 1000
    background: #07111A
    font_family: "DejaVu Sans"
    font_fallback: "DejaVu Sans Mono"
  }

  font "sans" { family: "DejaVu Sans"; fallback: "DejaVu Sans Mono" }
  font "mono" { family: "DejaVu Sans Mono"; fallback: "DejaVu Sans" }

  let ink       = #07111A
  let teal_deep = #0E2A33
  let alu       = #C9D6E0
  let amber     = #FFB45C
  let beak_col  = #F28A3D
  let ivory     = #F4EEE3
  let cyan      = #65D9FF
  let lime      = #B8F26A

  // ── Motion primitives ──────────────────────────────────────────────────────
  let bob      = oscillate(t, 0.22, -2.4, 2.4, 30)      // body breathing bob
  let tilt     = oscillate(t, 0.11, -2.6, 2.6, 200)     // slow head tilt (deg)
  let tc       = cos(tilt)
  let ts       = sin(tilt)
  let hx       = 826
  let hy       = 350
  let mtx      = hx - hx * tc + hy * ts
  let mty      = hy - hx * ts - hy * tc + bob
  let blinkraw = abs(wave(t, 0.32, -90)) * 9.0
  let blink    = clamp(blinkraw, 0.0, 1.0)
  let breath   = 0.5 + 0.5 * wave(t, 0.22, 30)
  let lume     = 0.72 + 0.28 * wave(t, 0.18, 40)
  let sway     = oscillate(t, 0.16, -1.5, 1.5, 140)

  // ── Palette surfaces ───────────────────────────────────────────────────────
  diffusion_gradient "studio_wall" {
    point(0.04, 0.10, #0B2730, weight: 1.7)
    point(0.34, 0.22, #0E2A33, weight: 1.25)
    point(0.62, 0.08, #11343D, weight: 1.0)
    point(0.92, 0.36, #061820, weight: 1.4)
    point(0.16, 0.70, #050E14, weight: 1.6)
    point(0.58, 0.88, #07141B, weight: 1.15)
  }

  radial_gradient "cool_ambient" {
    center: (0.5, 0.5)
    radius: 0.5
    stop(0.0, fade(#4FC8E8, 0.16))
    stop(0.45, fade(#2A8CA8, 0.07))
    stop(1.0, fade(#07111A, 0.0))
  }

  radial_gradient "warm_ambient" {
    center: (0.5, 0.5)
    radius: 0.5
    stop(0.0, fade(#FFB45C, 0.15))
    stop(0.42, fade(#B96A2C, 0.06))
    stop(1.0, fade(#07111A, 0.0))
  }

  radial_gradient "halo_goose" {
    center: (0.5, 0.5)
    radius: 0.5
    stop(0.0, fade(#B9E9F2, 0.10))
    stop(0.55, fade(#4B95A6, 0.045))
    stop(1.0, fade(#07111A, 0.0))
  }

  linear_gradient "desk_wood" {
    from: (0.15, 0.0)
    to: (0.55, 1.0)
    stop(0.0, #39251C)
    stop(0.22, #2A1A14)
    stop(0.62, #190F0C)
    stop(1.0, #0B0706)
  }

  linear_gradient "shelf_wood" {
    angle: 96
    stop(0.0, #43291D)
    stop(0.35, #2C1A13)
    stop(1.0, #150D09)
  }

  linear_gradient "alu_face" {
    angle: 104
    stop(0.0, #F0F6FA)
    stop(0.30, #D6E1E8)
    stop(0.62, #AEBDC8)
    stop(0.86, #8998A3)
    stop(1.0, #C4D0D8)
  }

  linear_gradient "alu_edge" {
    angle: 90
    stop(0.0, #F7FBFD)
    stop(0.18, #C9D6E0)
    stop(0.55, #7E8D98)
    stop(1.0, #3E4951)
  }

  linear_gradient "alu_dark" {
    angle: 100
    stop(0.0, #A9B8C3)
    stop(0.45, #6E7D88)
    stop(1.0, #3D474F)
  }

  linear_gradient "screen_ink" {
    angle: 115
    stop(0.0, #0A1B25)
    stop(0.42, #061119)
    stop(1.0, #02080C)
  }

  linear_gradient "goose_body" {
    from: (0.42, 0.0)
    to: (0.58, 1.0)
    stop(0.0, #FFFDF7)
    stop(0.28, #F8F1E5)
    stop(0.62, #E9DDCA)
    stop(0.86, #D2C1AB)
    stop(1.0, #B7A48E)
  }

  linear_gradient "goose_neck" {
    from: (0.20, 0.0)
    to: (0.78, 1.0)
    stop(0.0, #FFFDF8)
    stop(0.36, #F7EFE2)
    stop(0.74, #E2D4C0)
    stop(1.0, #C3B09A)
  }

  linear_gradient "goose_wing" {
    from: (0.10, 0.0)
    to: (0.62, 1.0)
    stop(0.0, #FBF4E7)
    stop(0.36, #EADDC9)
    stop(0.72, #D2BFA7)
    stop(1.0, #AE9780)
  }

  linear_gradient "beak_grad" {
    from: (0.0, 0.2)
    to: (1.0, 0.8)
    stop(0.0, #FFC078)
    stop(0.34, #F79A4C)
    stop(0.72, #ED7F35)
    stop(1.0, #C85E22)
  }

  linear_gradient "rim_goose" {
    from: (0.0, 0.5)
    to: (1.0, 0.5)
    stop(0.0, fade(#FFD7A1, 0.98))
    stop(0.42, fade(#FFF7E9, 0.62))
    stop(0.72, fade(#A9ECFF, 0.62))
    stop(1.0, fade(#65D9FF, 0.72))
  }

  radial_gradient "shadow_soft" {
    center: (0.5, 0.5)
    radius: 0.5
    stop(0.0, fade(#000000, 0.58))
    stop(0.55, fade(#000000, 0.30))
    stop(1.0, fade(#000000, 0.0))
  }

  radial_gradient "shadow_wide" {
    center: (0.5, 0.5)
    radius: 0.5
    stop(0.0, fade(#000000, 0.42))
    stop(0.60, fade(#000000, 0.16))
    stop(1.0, fade(#000000, 0.0))
  }

  radial_gradient "screen_cyan_glow" {
    center: (0.5, 0.5)
    radius: 0.5
    stop(0.0, fade(#65D9FF, 0.20))
    stop(0.40, fade(#2E9EC4, 0.09))
    stop(1.0, fade(#07111A, 0.0))
  }

  radial_gradient "screen_amber_glow" {
    center: (0.5, 0.5)
    radius: 0.5
    stop(0.0, fade(#FFB45C, 0.18))
    stop(0.42, fade(#C2743A, 0.08))
    stop(1.0, fade(#07111A, 0.0))
  }

  radial_gradient "screen_violet_glow" {
    center: (0.5, 0.5)
    radius: 0.5
    stop(0.0, fade(#A78BFA, 0.18))
    stop(0.42, fade(#6B5AB8, 0.08))
    stop(1.0, fade(#07111A, 0.0))
  }

  radial_gradient "lamp_glow" {
    center: (0.5, 0.5)
    radius: 0.5
    stop(0.0, fade(#FFD39A, 0.55))
    stop(0.35, fade(#FFB45C, 0.20))
    stop(1.0, fade(#FFB45C, 0.0))
  }

  linear_gradient "lamp_cone" {
    from: (0.0, 0.0)
    to: (0.55, 1.0)
    stop(0.0, fade(#FFC27A, 0.20))
    stop(0.40, fade(#FFB45C, 0.07))
    stop(1.0, fade(#FFB45C, 0.0))
  }

  radial_gradient "moon_disc" {
    center: (0.40, 0.35)
    radius: 0.62
    stop(0.0, #FFFDF0)
    stop(0.42, #F6E7C6)
    stop(0.78, #E4CDA2)
    stop(1.0, #C8AC7C)
  }

  radial_gradient "bokeh_warm" {
    center: (0.40, 0.38)
    radius: 0.55
    stop(0.0, fade(#FFD9A0, 0.50))
    stop(0.55, fade(#FFB45C, 0.26))
    stop(0.92, fade(#FFB45C, 0.04))
    stop(1.0, fade(#FFB45C, 0.0))
  }

  radial_gradient "bokeh_cool" {
    center: (0.40, 0.38)
    radius: 0.55
    stop(0.0, fade(#C8F4FF, 0.42))
    stop(0.55, fade(#65D9FF, 0.20))
    stop(0.92, fade(#65D9FF, 0.03))
    stop(1.0, fade(#65D9FF, 0.0))
  }

  radial_gradient "bokeh_lime" {
    center: (0.40, 0.38)
    radius: 0.55
    stop(0.0, fade(#E5FFC0, 0.34))
    stop(0.55, fade(#B8F26A, 0.16))
    stop(1.0, fade(#B8F26A, 0.0))
  }

  linear_gradient "window_sky" {
    from: (0.2, 0.0)
    to: (0.7, 1.0)
    stop(0.0, #071C26)
    stop(0.45, #0A2631)
    stop(0.78, #0D303B)
    stop(1.0, #143D46)
  }

  linear_gradient "city_far" {
    angle: 90
    stop(0.0, #0A222B)
    stop(1.0, #06141A)
  }

  linear_gradient "glass_sheen" {
    from: (0.0, 0.0)
    to: (1.0, 1.0)
    stop(0.0, fade(#FFFFFF, 0.0))
    stop(0.48, fade(#BFEFFF, 0.05))
    stop(0.58, fade(#E8FBFF, 0.09))
    stop(1.0, fade(#FFFFFF, 0.0))
  }

  radial_gradient "vignette" {
    center: (0.50, 0.44)
    radius: 0.78
    stop(0.0, fade(#02070A, 0.0))
    stop(0.52, fade(#02070A, 0.04))
    stop(0.78, fade(#02070A, 0.30))
    stop(1.0, fade(#02070A, 0.66))
  }

  noise_gradient "wall_tooth" {
    scale: 22
    octaves: 4
    persistence: 0.55
    lacunarity: 2.1
    seed: 41
    grain: 0.012
    stop(0.0, fade(#FFFFFF, 0.0))
    stop(0.55, fade(#BFE7EF, 0.022))
    stop(1.0, fade(#FFFFFF, 0.05))
  }

  noise_gradient "screen_tooth" {
    scale: 2.2
    octaves: 3
    persistence: 0.5
    seed: 12
    grain: 0.035
    stop(0.0, fade(#65D9FF, 0.018))
    stop(1.0, fade(#FFFFFF, 0.045))
  }

  // ═══ BACKGROUND WALL ══════════════════════════════════════════════════════
  rect { x: 0; y: 0; width: 1600; height: 1000; fill: @studio_wall }
  ellipse { center: (1210, 330); radii: (520, 430); fill: @cool_ambient; blend: screen }
  ellipse { center: (70, 610); radii: (430, 470); fill: @warm_ambient; blend: screen }
  ellipse { center: (700, 370); radii: (360, 340); fill: @halo_goose; blend: screen }

  // faint studio ring motif behind the goose
  circle { center: (690, 362); radius: 292; fill: none; stroke: fade(#9FD4DE, 0.085); stroke_width: 1.5 }
  circle { center: (690, 362); radius: 252; fill: none; stroke: fade(#9FD4DE, 0.045); stroke_width: 1; dash: [2, 7] }
  repeat "ring_ticks" {
    count: 36
    pivot: (690, 362)
    step_rotate: 10
    line { from: (690, 72); to: (690, 64); stroke: fade(#BFE7EF, 0.10); stroke_width: 1.2 }
  }

  // wall panel seams
  repeat "wall_seams" {
    count: 8
    line { from: (i * 200 + 40, 0); to: (i * 200 + 40, 646); stroke: fade(#0A1A21, 0.55); stroke_width: 1 }
  }
  rect { x: 0; y: 636; width: 1600; height: 22; fill: fade(#02080C, 0.30) }
  rect { x: 0; y: 636; width: 1600; height: 1; fill: fade(#7FB3BE, 0.10) }

  // ═══ WINDOW / NIGHT CITY ══════════════════════════════════════════════════
  // frame
  rect "win_frame" {
    x: 946
    y: 54
    width: 622
    height: 562
    radius: 12
    fill: #18262B
    stroke: fade(#DCE9F0, 0.34)
    stroke_width: 1.5
    stroke_align: inner
    shadow: (0, 18, 42, fade(#000000, 0.50))
  }
  rect "win_glass" { x: 960; y: 68; width: 594; height: 534; radius: 5; fill: @window_sky }

  // night sky wash
  ellipse { center: (1300, 200); radii: (320, 180); fill: fade(#4FB9D6, 0.07); blend: screen }
  ellipse { center: (1120, 520); radii: (260, 120); fill: fade(#FFB45C, 0.05); blend: screen }

  // moon
  circle { center: (1444, 148); radius: 31; fill: @moon_disc; glow: (42, fade(#FFE3B0, 0.30)) }
  circle { center: (1432, 140); radius: 6; fill: fade(#D8C39C, 0.30) }
  circle { center: (1452, 158); radius: 4.2; fill: fade(#D8C39C, 0.24) }
  circle { center: (1438, 162); radius: 3; fill: fade(#D8C39C, 0.20) }
  ellipse { center: (1402, 194); radii: (74, 8); fill: fade(#0A2631, 0.34) }
  ellipse { center: (1482, 188); radii: (44, 5); fill: fade(#0A2631, 0.30) }

  // distant skyline
  rect { x: 960; y: 470; width: 594; height: 132; fill: @city_far }
  rect { x: 984; y: 404; width: 76; height: 190; fill: #0A2028 }
  rect { x: 1006; y: 372; width: 34; height: 222; fill: #0B222A }
  rect { x: 1066; y: 440; width: 92; height: 154; fill: #081B22 }
  rect { x: 1112; y: 402; width: 30; height: 192; fill: #0A1F27 }
  rect { x: 1160; y: 458; width: 118; height: 136; fill: #071920 }
  rect { x: 1226; y: 386; width: 44; height: 208; fill: #0B222A }
  rect { x: 1244; y: 358; width: 8; height: 30; fill: #0B222A }
  rect { x: 1284; y: 430; width: 86; height: 164; fill: #081A21 }
  rect { x: 1330; y: 396; width: 26; height: 198; fill: #0A1E26 }
  rect { x: 1378; y: 462; width: 108; height: 132; fill: #07181F }
  rect { x: 1452; y: 418; width: 62; height: 176; fill: #091D24 }
  rect { x: 1494; y: 452; width: 60; height: 142; fill: #071820 }

  // foreground towers and antennas
  rect { x: 1032; y: 438; width: 26; height: 156; fill: #071820 }
  rect { x: 1188; y: 414; width: 18; height: 180; fill: #091C24 }
  rect { x: 1312; y: 470; width: 24; height: 124; fill: #07181F }
  rect { x: 1402; y: 440; width: 20; height: 154; fill: #081A21 }
  rect { x: 1512; y: 426; width: 32; height: 168; fill: #07171E }
  line { from: (1248, 358); to: (1248, 300); stroke: fade(#9FC8D2, 0.25); stroke_width: 2 }
  line { from: (1078, 380); to: (1078, 336); stroke: fade(#9FC8D2, 0.20); stroke_width: 1.5 }
  line { from: (1343, 396); to: (1343, 350); stroke: fade(#9FC8D2, 0.18); stroke_width: 1.5 }
  circle { center: (1248, 298); radius: 2.2; fill: #FF7B6B; opacity: 0.7 * lume; glow: (8, fade(#FF7B6B, 0.5)) }
  circle { center: (1078, 334); radius: 1.6; fill: #FF7B6B; opacity: 0.5 * lume }
  rect { x: 966; y: 564; width: 588; height: 38; fill: fade(#3D7A86, 0.14); blend: screen }
  ellipse { center: (1270, 588); radii: (280, 26); fill: fade(#6FC6D8, 0.10); blend: screen }

  // lit windows — a scatter of warm and cool
  repeat "city_lights" {
    count: 34
    let col = i - floor(i / 8) * 8
    let row = floor(i / 8)
    let lx = 976 + col * 68 + (row - 2) * 9
    let ly = 420 + row * 31
    rect {
      x: lx
      y: ly
      width: 5
      height: 8
      radius: 1
      fill: mix(#FFC978, #8FE3F2, (col * 3 + row * 5) / 12.0)
      opacity: 0.28 + 0.30 * abs(wave(t, 0.021 + row * 0.004, col * 47))
    }
  }

  repeat "city_lights_2" {
    count: 22
    let col2 = i - floor(i / 6) * 6
    let row2 = floor(i / 6)
    let lx2 = 1008 + col2 * 83 + (row2 - 2) * 6
    let ly2 = 468 + row2 * 22
    rect {
      x: lx2
      y: ly2
      width: 4
      height: 6
      radius: 1
      fill: mix(#FFD79A, #7FD9EA, (col2 + row2) / 6.0)
      opacity: 0.16 + 0.36 * abs(wave(t, 0.018 + col2 * 0.003, row2 * 61))
    }
  }

  repeat "tower_grid_left" {
    count: 24
    let gc = i - floor(i / 6) * 6
    let gr = floor(i / 6)
    rect {
      x: 992 + gc * 11
      y: 424 + gr * 20
      width: 4
      height: 6
      radius: 1
      fill: mix(#FFD79A, #8FE3F2, gc / 6.0)
      opacity: 0.12 + 0.30 * abs(wave(t, 0.02 + gr * 0.002, gc * 57))
    }
  }
  repeat "tower_grid_right" {
    count: 30
    let gc2 = i - floor(i / 6) * 6
    let gr2 = floor(i / 6)
    rect {
      x: 1180 + gc2 * 12
      y: 476 + gr2 * 16
      width: 4
      height: 5
      radius: 1
      fill: mix(#FFD79A, #9FE8FF, gr2 / 5.0)
      opacity: 0.10 + 0.28 * abs(wave(t, 0.018 + gc2 * 0.002, gr2 * 43))
    }
  }

  // bokeh — slow drifting out-of-focus city lights
  circle { center: (1024 + oscillate(t, 0.05, -8, 8), 314 + oscillate(t, 0.04, -5, 5, 90)); radius: 13; fill: @bokeh_warm; blend: screen }
  circle { center: (1096 + oscillate(t, 0.045, -10, 10, 40), 268 + oscillate(t, 0.035, -6, 6)); radius: 16; fill: @bokeh_cool; blend: screen }
  circle { center: (1188 + oscillate(t, 0.04, -7, 7, 120), 336 + oscillate(t, 0.05, -8, 8, 30)); radius: 17; fill: @bokeh_warm; blend: screen }
  circle { center: (1268 + oscillate(t, 0.055, -9, 9, 200), 250 + oscillate(t, 0.03, -4, 4, 60)); radius: 11; fill: @bokeh_lime; blend: screen }
  circle { center: (1350 + oscillate(t, 0.038, -6, 6, 70), 392 + oscillate(t, 0.045, -7, 7, 190)); radius: 11; fill: @bokeh_cool; blend: screen }
  circle { center: (1460 + oscillate(t, 0.05, -8, 8, 150), 330 + oscillate(t, 0.04, -6, 6, 40)); radius: 15; fill: @bokeh_warm; blend: screen }
  circle { center: (1512 + oscillate(t, 0.042, -5, 5, 220), 430 + oscillate(t, 0.05, -6, 6, 110)); radius: 9; fill: @bokeh_lime; blend: screen }
  circle { center: (1150 + oscillate(t, 0.048, -6, 6, 10), 486 + oscillate(t, 0.035, -4, 4, 180)); radius: 7; fill: @bokeh_warm; blend: screen }
  circle { center: (1408 + oscillate(t, 0.036, -7, 7, 250), 500 + oscillate(t, 0.05, -5, 5, 70)); radius: 12; fill: @bokeh_cool; blend: screen }

  // glass sheen + mullions
  polygon {
    points: [(1000, 68), (1230, 68), (1050, 602), (960, 602)]
    fill: @glass_sheen
    opacity: 0.55
    blend: screen
  }
  spline {
    points: [(1012, 70), (1064, 150), (1092, 252), (1128, 352), (1180, 470), (1222, 600)]
    tension: 0.5
    stroke: fade(#DFF7FF, 0.10)
    stroke_width: 2
  }
  repeat "rain" {
    count: 10
    line {
      from: (978 + i * 61, 72)
      to: (946 + i * 61, 598)
      stroke: fade(#BFEFFF, 0.045)
      stroke_width: 1.1
      clip: @win_glass
    }
  }
  line { from: (1030, 84); to: (1014, 250); stroke: fade(#DFF7FF, 0.07); stroke_width: 1.4; clip: @win_glass }
  line { from: (1180, 300); to: (1154, 596); stroke: fade(#DFF7FF, 0.06); stroke_width: 1.2; clip: @win_glass }
  line { from: (1390, 96); to: (1370, 334); stroke: fade(#DFF7FF, 0.05); stroke_width: 1.2; clip: @win_glass }
  rect { x: 1250; y: 68; width: 11; height: 534; fill: #0A171C; stroke: fade(#D8E9F0, 0.16); stroke_width: 1 }
  rect { x: 960; y: 332; width: 594; height: 9; fill: #0A171C; stroke: fade(#D8E9F0, 0.14); stroke_width: 1 }
  rect { x: 946; y: 606; width: 622; height: 14; radius: 3; fill: #26343A; stroke: fade(#FFDFB6, 0.22); stroke_width: 1 }

  // ═══ SHELF (top left) ══════════════════════════════════════════════════════
  rect "shelf_slab" {
    x: 156
    y: 356
    width: 440
    height: 18
    radius: 4
    fill: @shelf_wood
    stroke: fade(#FFC98C, 0.16)
    stroke_width: 1
    stroke_align: inner
    shadow: (0, 10, 20, fade(#000000, 0.55))
  }
  rect { x: 160; y: 356; width: 432; height: 2; fill: fade(#F0C08A, 0.28) }
  line { from: (176, 374); to: (176, 356); stroke: fade(#000000, 0.0); stroke_width: 0 }
  polygon { points: [(196, 374), (228, 374), (228, 404), (196, 374)]; fill: fade(#1A100C, 0.9) }
  polygon { points: [(520, 374), (552, 374), (552, 404), (520, 374)]; fill: fade(#1A100C, 0.9) }

  // books on shelf
  rect { x: 482; y: 300; width: 22; height: 56; radius: 2; fill: #314B49; stroke: fade(#A9D8D2, 0.20); stroke_width: 1 }
  rect { x: 506; y: 288; width: 18; height: 68; radius: 2; fill: #6B4030; stroke: fade(#FFC27A, 0.20); stroke_width: 1 }
  rect { x: 526; y: 306; width: 24; height: 50; radius: 2; fill: #243A46; stroke: fade(#B6E6F2, 0.18); stroke_width: 1 }
  line { from: (486, 316); to: (486, 346); stroke: fade(#E9D7B0, 0.45); stroke_width: 1 }
  line { from: (530, 318); to: (530, 344); stroke: fade(#CFEAF2, 0.35); stroke_width: 1 }
  line { from: (510, 300); to: (520, 300); stroke: fade(#FFD7A1, 0.40); stroke_width: 1 }

  // small potted plant on the shelf
  path {
