  path { fill: none; stroke: #C7A165; stroke_width: 1.6; cap: round; matrix: (tc, ts, -ts, tc, mtx, mty); move(769, 323); cubic(760, 318, 752, 314, 744, 312) }
  path { fill: none; stroke: fade(#FFFFFF, 0.55); stroke_width: 1.3; cap: round; matrix: (tc, ts, -ts, tc, mtx, mty); move(828, 322); cubic(834, 318, 842, 318, 848, 321) }
  path { fill: none; stroke: fade(#FFFFFF, 0.32); stroke_width: 1; cap: round; matrix: (tc, ts, -ts, tc, mtx, mty); move(776, 320); cubic(780, 317, 786, 316, 790, 317) }

  // ═══ GOOSE — WING ON THE KEYBOARD ═════════════════════════════════════════
  ellipse { center: (812, 888); radii: (64, 15); fill: fade(#000000, 0.42); opacity: 0.85 }

  // one continuous wing: shoulder to the keycaps
  path "goose_wing" {
    closed: true
