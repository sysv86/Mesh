  circle { center: (839.4, 331.6); radius: 2.2 * blink; fill: #FFFFFF; opacity: 0.92; matrix: (tc, ts, -ts, tc, mtx, mty) }
  circle { center: (845.4, 338.2); radius: 1.1; fill: #C8EFFF; opacity: 0.55 * blink; matrix: (tc, ts, -ts, tc, mtx, mty) }
