    stroke_align: inner
    shadow: (6, 10, 18, fade(#000000, 0.32))
    translate: (0, bob * 0.62)
    move(596, 636)
    cubic(652, 624, 700, 658, 722, 708)
    cubic(744, 758, 782, 816, 824, 850)
    cubic(844, 866, 848, 882, 834, 892)
    cubic(818, 902, 794, 890, 772, 874)
    cubic(722, 836, 670, 790, 628, 746)
    cubic(594, 710, 576, 674, 596, 636)
    close()
  }
  // volume: shadow the trailing edge, light the shoulder
