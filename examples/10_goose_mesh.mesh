  circle { center: (842, 335); radius: 24; fill: fade(#9FE8FF, 0.035); stroke: #C7A165; stroke_width: 1.8; matrix: (tc, ts, -ts, tc, mtx, mty) }
  circle { center: (842, 335); radius: 22.6; fill: none; stroke: fade(#FFE0AE, 0.35); stroke_width: 0.7; matrix: (tc, ts, -ts, tc, mtx, mty) }
  circle { center: (786, 327); radius: 17; fill: fade(#9FE8FF, 0.025); stroke: #C7A165; stroke_width: 1.6; matrix: (tc, ts, -ts, tc, mtx, mty) }
