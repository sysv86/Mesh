  repeat "right_meter" {
    count: 12
    rect { x: 1278 + i * 18; y: 674; width: 10; height: 4; radius: 1; fill: mix(#A78BFA, #FFB45C, i / 11.0); opacity: 0.20 + 0.62 * (0.5 + 0.5 * wave(t, 0.45, i * 37)) }
  }
