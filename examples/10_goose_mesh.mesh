  text { at: (1212, 772); baseline: true; align: right; content: "4x"; size: 5.8; font: "mono"; fill: #65D9FF }

  // scanline + glass sweep
  rect {
    x: 812
    y: 560 + fract(t * 0.06) * 220
    width: 406
    height: 1.4
