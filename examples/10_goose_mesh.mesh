  ellipse { center: (566, 782); radii: (96, 48); fill: fade(#E2D3BE, 0.36); clip: @goose_body; translate: (0, bob * 0.35) }
  ellipse { center: (620, 728); radii: (78, 54); fill: fade(#F2E8D8, 0.34); clip: @goose_body; translate: (0, bob * 0.35) }
  ellipse { center: (648, 668); radii: (55, 40); fill: fade(#FFF9EC, 0.28); clip: @goose_body; translate: (0, bob * 0.35) }

