  path { fill: none; stroke: fade(#9A8269, 0.72); stroke_width: 1.6; cap: round; clip: @goose_wing; translate: (0, bob * 0.62); move(604, 674); cubic(634, 694, 676, 722, 710, 752) }
  path { fill: none; stroke: fade(#9A8269, 0.66); stroke_width: 1.6; cap: round; clip: @goose_wing; translate: (0, bob * 0.62); move(596, 722); cubic(630, 744, 672, 776, 704, 806) }
  path { fill: none; stroke: fade(#A68D73, 0.60); stroke_width: 1.5; cap: round; clip: @goose_wing; translate: (0, bob * 0.62); move(602, 770); cubic(636, 792, 676, 822, 708, 846) }
  path { fill: none; stroke: fade(#FFFDF7, 0.38); stroke_width: 1.4; cap: round; clip: @goose_wing; translate: (0, bob * 0.62); move(610, 654); cubic(642, 668, 680, 696, 706, 724) }
  // leading edge highlight
