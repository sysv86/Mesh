    stroke_align: inner
    shadow: (0, 12, 26, fade(#000000, 0.32))
    translate: (0, bob * 0.35)
    move(408, 704)
    cubic(388, 676, 402, 644, 446, 624)
    cubic(484, 596, 544, 578, 604, 584)
    cubic(664, 590, 714, 620, 732, 664)
    cubic(748, 712, 724, 774, 690, 804)
    cubic(656, 832, 580, 836, 534, 820)
    cubic(492, 806, 450, 780, 436, 752)
