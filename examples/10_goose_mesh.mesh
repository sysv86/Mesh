  path { fill: none; stroke: fade(#B39D84, 0.48); stroke_width: 1.4; cap: round; clip: @goose_body; translate: (0, bob * 0.35); move(704, 758); cubic(714, 770, 726, 772, 736, 764) }
  path { fill: none; stroke: fade(#B9A68E, 0.30); stroke_width: 1.3; cap: round; clip: @goose_body; translate: (0, bob * 0.35); move(694, 792); cubic(704, 804, 716, 806, 726, 798) }

