  // four key rows
  repeat "main_keys" {
    count: 56
    let col = i - floor(i / 14) * 14
    let row = floor(i / 14)
    rect {
      x: 756 + row * 9 + col * 33.4
      y: 823 + row * 14
      width: 29
      height: 10.5
      radius: 2
