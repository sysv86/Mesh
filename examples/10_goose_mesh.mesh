  // hinge
  rect { x: 806; y: 794; width: 418; height: 10; radius: 5; fill: #1A2227; stroke: fade(#C9D6E0, 0.24); stroke_width: 1 }
  rect { x: 826; y: 797; width: 378; height: 1.5; fill: fade(#FFFFFF, 0.22) }

  // ═══ GOOSE — NECK ═════════════════════════════════════════════════════════
  path "goose_neck" {
    closed: true
    fill: @goose_neck
    stroke: @rim_goose
    stroke_width: 1.5
    stroke_align: inner
    shadow: (10, 14, 22, fade(#000000, 0.20))
    translate: (0, bob)
    move(610, 702)
    cubic(630, 612, 690, 532, 735, 456)
    cubic(750, 426, 766, 400, 786, 392)
    cubic(816, 384, 851, 395, 866, 416)
    cubic(858, 454, 838, 494, 814, 534)
    cubic(790, 582, 764, 642, 738, 686)
    cubic(710, 704, 660, 708, 610, 702)
    close()
  }
  // neck shading / bounce
  ellipse { center: (676, 600); radii: (36, 110); fill: fade(#C9B59D, 0.28); rotate: -8; translate: (0, bob) }
  ellipse { center: (806, 520); radii: (26, 100); fill: fade(#FFFDF7, 0.30); rotate: 7; translate: (0, bob) }
  ellipse { center: (764, 606); radii: (16, 58); fill: fade(#8FE3F2, 0.10); translate: (0, bob) }

