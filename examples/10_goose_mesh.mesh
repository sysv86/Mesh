  rect { x: 854; y: 867 + press1; width: 29; height: 10.5; radius: 2; fill: #223038; stroke: #B8F26A; stroke_width: 0.9; glow: (7, fade(#B8F26A, 0.35)) }
  rect { x: 888; y: 881 + press2; width: 29; height: 11; radius: 2; fill: #223038; stroke: fade(#B8F26A, 0.8); stroke_width: 0.9; glow: (7, fade(#B8F26A, 0.30)) }
  rect { x: 822; y: 853 + press3; width: 29; height: 10.5; radius: 2; fill: #223038; stroke: fade(#B8F26A, 0.65); stroke_width: 0.9 }
