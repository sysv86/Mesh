  // ── eye ────────────────────────────────────────────────────────────────────
  ellipse { center: (842, 335); radii: (10.5, 1.2 + blink * 8.6); fill: #17100A; matrix: (tc, ts, -ts, tc, mtx, mty) }
  ellipse { center: (842, 335); radii: (6.4, 0.8 + blink * 5.6); fill: #6E4826; matrix: (tc, ts, -ts, tc, mtx, mty) }
