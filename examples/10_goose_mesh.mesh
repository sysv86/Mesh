    count: 26
    let dx = 60 + i * 58 + 18 * wave(i * 12.0, 0.05, 40)
    let dy = 120 + (i - floor(i / 7) * 7) * 116
    circle {
      center: (dx + oscillate(t, 0.03 + (i - floor(i / 7) * 7) * 0.004, -12, 12, i * 31), dy + oscillate(t, 0.024, -16, 16, i * 47))
      radius: 1.2 + (i - floor(i / 7) * 7) * 0.62
      fill: mix(#FFE0B0, #BDF1FF, (i - floor(i / 7) * 7) / 7.0)
      opacity: 0.28 + 0.42 * (0.5 + 0.5 * wave(t, 0.09, i * 67))
      glow: (5, fade(#FFE0B0, 0.16))
    }
  }
  // foreground bokeh
  circle { center: (120 + oscillate(t, 0.02, -10, 10), 710 + oscillate(t, 0.017, -8, 8, 60)); radius: 17; fill: @bokeh_warm; blend: screen; opacity: 0.7 }
  circle { center: (1560 + oscillate(t, 0.022, -8, 8, 100), 760 + oscillate(t, 0.018, -6, 6)); radius: 13; fill: @bokeh_warm; blend: screen; opacity: 0.6 }
  circle { center: (1470 + oscillate(t, 0.025, -10, 10, 140), 640 + oscillate(t, 0.02, -8, 8, 30)); radius: 12; fill: @bokeh_cool; blend: screen; opacity: 0.55 }

  // window beam across the desk
  polygon {
    points: [(1010, 600), (1330, 600), (1580, 1000), (1060, 1000)]
    fill: fade(#BFEFFF, 0.035)
    blend: screen
  }
  polygon {
    points: [(700, 600), (820, 600), (900, 1000), (600, 1000)]
    fill: fade(#FFB45C, 0.025)
    blend: screen
  }

  // cinematic grade
  ellipse { center: (150, 640); radii: (400, 480); fill: fade(#FFB45C, 0.055); blend: screen }
  ellipse { center: (1080, 690); radii: (420, 360); fill: fade(#65D9FF, 0.035); blend: screen }
  ellipse { center: (560, 700); radii: (300, 280); fill: fade(#FFCF9A, 0.025); blend: overlay }

  // vignette + film grain
  rect { x: 0; y: 0; width: 1600; height: 1000; fill: @vignette }
  rect { x: 0; y: 0; width: 1600; height: 1000; fill: @wall_tooth; blend: overlay; opacity: 0.55 }

  // bottom foreground silhouette — out-of-focus leaf, frames the corner
  path {
    closed: true
    fill: fade(#06100D, 0.88)
    move(0, 1000)
    cubic(0, 950, 26, 912, 58, 900)
    cubic(96, 918, 108, 954, 96, 1000)
    close()
  }
  path {
    closed: true
    fill: fade(#08120F, 0.82)
    move(1600, 1000)
    cubic(1600, 958, 1576, 930, 1548, 922)
    cubic(1518, 940, 1510, 968, 1520, 1000)
    close()
  }
}
